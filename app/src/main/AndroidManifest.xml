<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        tools:targetApi="31">

        <!-- QS 磁贴「相机设置」：外屏相机 UI 没有设置入口，用它直接开
             com.android.camera/.CameraPreferenceActivity（exported，带 APP_SETTINGS filter） -->
        <service
            android:name=".CameraSettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_camera_settings"
            android:label="@string/tile_camera_settings"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
